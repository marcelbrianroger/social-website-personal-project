# Reference copy of the environment contract. Copy to .env and fill in.
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# PRODUCTION SPLIT (Vercel + Railway)
# ---------------------------------------------------------------------------
# Locally one .env feeds both processes. Deployed, they are two hosts with two
# separate variable sets, and most vars belong to exactly one of them:
#
#   Vercel (Next.js)      SESSION_JWT_SECRET, SOCKET_URL, GEO_*, TURN_*
#   Railway (socket)      SESSION_JWT_SECRET, SOCKET_CORS_ORIGIN, REDIS_URL,
#                         DISCONNECT_GRACE_MS, NODE_ENV. PORT is injected.
#
# SESSION_JWT_SECRET must be byte-identical on both or every handshake fails.
# It signs the socket tickets Vercel mints and the socket server verifies.
# Nothing in the Next.js app reads REDIS_URL or DATABASE_URL at runtime, so
# Railway's Redis stays on the private network and is never exposed publicly.
#
# See docs/deploy.md for the full runbook.
# ---------------------------------------------------------------------------

# --- Postgres ---
# UNUSED AT RUNTIME. Nothing imports lib/db/prisma.ts yet — the schema is
# scaffolded ahead of the moderation/stats work.
#
# Not required on Vercel either: `prisma generate` (run by the root postinstall,
# reading prisma.config.ts) was verified to exit 0 with this unset, because
# generating a client needs the schema, not a reachable database. Set it only
# once something actually queries.
DATABASE_URL="postgresql://admin:password123@localhost:5432/dududb?schema=public"

# --- Redis ---
# Socket server only. On Railway, reference the Redis service over the private
# network rather than pasting a URL: REDIS_URL=${{Redis.REDIS_URL}}
#
# Must be a real Redis speaking the TCP protocol. The socket server holds two
# long-lived SUBSCRIBE connections (@socket.io/redis-adapter) plus the
# dudu:broadcast channel, so a REST-only Redis will not work.
REDIS_URL="redis://localhost:6379"

# --- Anonymous session signing ---
# REQUIRED. Must be identical in the Next.js app and the /server process,
# otherwise the Socket.io handshake will reject every session cookie.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_JWT_SECRET=""

# --- Region lock ---
# Comma-separated ISO 3166-1 alpha-2 codes.
GEO_ALLOWED_COUNTRIES="DE"

# Trust an upstream-supplied country header.
# SECURITY: leave "false" unless a reverse proxy you control unconditionally
# overwrites GEO_TRUSTED_COUNTRY_HEADER on every request. If it merely adds the
# header when absent, any client can forge it and defeat the region lock.
#
# ON VERCEL: set this to "true" and the header to "x-vercel-ip-country".
# Vercel's edge overwrites that header on every request, which satisfies the
# condition above. This is how the region lock works in production without the
# GeoLite2 .mmdb file, which is gitignored and never reaches the deployment.
GEO_TRUST_PROXY_HEADERS="false"
GEO_TRUSTED_COUNTRY_HEADER="x-geo-country"

# Self-hosted GeoIP fallback. Download GeoLite2-Country.mmdb from MaxMind
# (free account required) and place it at this path.
MAXMIND_DB_PATH="./data/GeoLite2-Country.mmdb"

# Behaviour when the country cannot be resolved by any source: "allow" | "deny".
# "deny" is the strict choice; it will also block anyone behind a proxy the
# GeoIP database does not recognise.
GEO_FALLBACK="allow"

# Skip the region lock for loopback/private-range addresses so local dev works.
GEO_BYPASS_LOCALHOST="true"

# --- Socket.io ---
# SOCKET_PORT is local only. Managed hosts inject PORT and it takes precedence;
# binding anything else leaves the process listening where the platform router
# does not forward, so the deploy goes green and every connection times out.
SOCKET_PORT="4000"

# Comma-separated allowlist of browser origins permitted to open a handshake.
# Vercel mints a fresh URL per preview deploy, so a single origin means only
# production ever connects. Not the security boundary — the handshake still
# demands a session JWT — this only decides whose browser may try.
#   e.g. "https://dudu.vercel.app,https://dudu-git-dev-you.vercel.app"
SOCKET_CORS_ORIGIN="http://localhost:3000"

# Where the browser dials the socket server. In production this is the Railway
# https:// URL — socket.io upgrades to wss:// on its own. No trailing slash: it
# survives into the Origin header and would fail to match SOCKET_CORS_ORIGIN.
#
# Read per request by /api/socket-ticket and handed to the browser, so editing
# it in the Vercel dashboard takes effect on save without a rebuild.
SOCKET_URL="http://localhost:4000"

# Legacy build-time fallback, used only if SOCKET_URL is unset. NEXT_PUBLIC_
# vars are inlined during `next build`, so a deployment compiled before this was
# set ships no address at all and live features stay off until a redeploy.
# Prefer SOCKET_URL above.
# NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# How long a player who drops mid-game has to come back before the game
# eliminates them and carries on without them. Long enough for a page refresh
# or a phone changing cell; short enough that a table is not held hostage by
# someone who has left.
#
# `npm run smoke:disconnect` waits out a real window, so set this to something
# like "3000" and restart the server before running it.
DISCONNECT_GRACE_MS="30000"

# --- WebRTC / TURN (optional) ---
# Next.js app only. STUN alone connects most home networks. Peers behind
# symmetric NAT need a TURN relay; without one, ~10-20% of real-world pairs
# never connect and sit at "checking" forever.
#
# Deliberately NOT NEXT_PUBLIC_. Those ship to the browser, where anyone can
# read the credentials and relay their own traffic at your expense, forever.
# app/api/ice/route.ts mints per-visitor credentials from the secret below
# using the coturn REST scheme, so nothing long-lived reaches the client.
#
# Leaving these empty is a supported state: the route returns STUN only and
# rooms still work for most pairs.

# Comma-separated; providers usually give several transports sharing a secret.
#   e.g. "turn:relay.example.com:3478?transport=udp,turns:relay.example.com:5349"
TURN_URL=""

# The TURN server's static-auth-secret (coturn `use-auth-secret`), or the
# equivalent from a hosted provider. Never expose this to the browser.
TURN_STATIC_AUTH_SECRET=""

# How long a minted credential stays valid. Defaults to 12h. Credentials are
# handed out per room open, so this only bounds how long a leaked one lives.
TURN_TTL_SECONDS="43200"
