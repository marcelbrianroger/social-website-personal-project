# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client (see generator `output` in prisma/schema.prisma)
/lib/generated

# server build output
/server/dist

# MaxMind GeoLite2 database — licensed, download separately
/data/*.mmdb

# AI coding-assistant workspaces. Vendored tool documentation and per-machine
# permission settings — neither is project source. The instructions that DO
# belong to the project live in AGENTS.md and CLAUDE.md at the repo root.
.agents/
.claude/
.windsurf/
skills-lock.json
