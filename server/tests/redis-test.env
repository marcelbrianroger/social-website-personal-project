# Environment overrides for the integration suite.
#
# Loaded with `node --env-file=` so it is populated BEFORE src/env.ts runs its
# dotenv load of the repo-root .env. dotenv does not overwrite variables that
# are already set, so this wins.
#
# The only thing that changes is the Redis DATABASE INDEX. The suite flushes
# its database between tests, and flushing db 0 would wipe the rooms, queue and
# DUDU wall of any dev server running against the same container.
REDIS_URL="redis://localhost:6379/15"
